# workarea 生产环境配置
# 复制此文件为 .env.production 并填入真实值

# API 配置
VITE_API_BASE_URL=https://your-api-domain.com/api
VITE_CLIENT_APP=workarea
VITE_ENABLE_MOCK=false

# 错误监控配置 - 生产环境必须配置
# VITE_SENTRY_DSN=your-production-sentry-dsn-here

# CSP 白名单配置
# 多个 origin 用英文逗号分隔；只填协议+域名+端口，不要填路径，也不要填裸 https:
VITE_CSP_IMG_ORIGINS=https://api.qrserver.com,https://your-cdn-domain.com
VITE_CSP_CONNECT_ORIGINS=https://your-download-domain.com

# 功能开关 - 生产环境关闭调试
VITE_ENABLE_DEBUG=false
VITE_ENABLE_PERFORMANCE_MONITORING=true

# 第三方服务配置 - 生产环境配置
VITE_DIFY_WORKSPACE_ID=prod-workspace-id
VITE_OSS_REGION=oss-cn-hangzhou


# ====================================
# 阿里云短信服务配置（生产环境）
# ====================================
AL_SIGN_NAME=your_sms_sign_name
AL_TEMPLATE_CODE=your_sms_template_code
