name: ci

on:
  pull_request:
    paths:
      - "src/**"
      - "public/**"
      - "docs/api/**"
      - "docs/baseline/**"
      - "docs/security/**"
      - "scripts/**"
      - "tests/**"
      - "package.json"
      - "package-lock.json"
      - ".nvmrc"
      - "playwright.config.ts"
      - "jest.config.mjs"
      - "docs/CHANGELOG.md"
      - "tsconfig*.json"
      - "vite.config.ts"
      - "tailwind.config.*"
      - "eslint.config.js"
      - "postcss.config.cjs"
      - ".spectral.yml"
      - ".github/workflows/ci.yml"
      - "README.md"
  push:
    branches:
      - main
      - master
    paths:
      - "src/**"
      - "public/**"
      - "docs/api/**"
      - "docs/baseline/**"
      - "docs/security/**"
      - "scripts/**"
      - "tests/**"
      - "package.json"
      - "package-lock.json"
      - ".nvmrc"
      - "playwright.config.ts"
      - "jest.config.mjs"
      - "docs/CHANGELOG.md"
      - "tsconfig*.json"
      - "vite.config.ts"
      - "tailwind.config.*"
      - "eslint.config.js"
      - "postcss.config.cjs"
      - ".spectral.yml"
      - ".github/workflows/ci.yml"
      - "README.md"

jobs:
  ci:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version-file: ".nvmrc"
          cache: "npm"

      - name: Verify Node and npm runtime
        run: node scripts/runtime/assert-node-version.mjs

      - name: Verify lockfile registry
        run: node scripts/dependencies/check-lockfile-registry.mjs

      - name: Install dependencies
        run: npm ci

      - name: Security scan
        run: npm run security:scan

      - name: Production dependency audit
        run: npm run audit:prod:ci

      - name: Dependency declaration check
        run: npm run deps:check

      - name: Type check
        run: npm run type-check

      - name: Lint
        run: npm run lint

      - name: API validate
        run: npm run api:validate:ci

      - name: API strict drift
        run: npm run api:drift:strict

      - name: API docs sync check
        run: npm run api:docs:check

      - name: Test
        run: npm run test:ci

      - name: Script tests
        run: npm run scripts:test

      - name: Build
        run: npm run build:verify

  e2e:
    name: e2e
    runs-on: ubuntu-latest
    needs: ci
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version-file: ".nvmrc"
          cache: "npm"

      - name: Verify Node and npm runtime
        run: node scripts/runtime/assert-node-version.mjs

      - name: Verify lockfile registry
        run: node scripts/dependencies/check-lockfile-registry.mjs

      - name: Install dependencies
        run: npm ci

      - name: Install Playwright browser
        run: npx playwright install --with-deps chromium

      - name: Run Playwright E2E
        env:
          OASIS_E2E_OUTPUT_DIR: output/playwright
        run: npm run test:e2e -- --project=chromium

      - name: Upload Playwright report
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: playwright-report
          path: output/playwright/
          if-no-files-found: ignore
