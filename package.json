{
  "name": "oasis-workspace",
  "version": "1.0.7",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "predev": "npm run changelog:sync",
    "prebuild": "npm run changelog:sync",
    "postbuild": "node scripts/build/strip-katex-fonts.mjs",
    "dev": "vite",
    "build": "vite build",
    "build:size-check": "node scripts/build/check-bundle-size.mjs",
    "build:production-check": "node scripts/build/check-production-output.mjs",
    "build:verify": "vite build && node scripts/build/strip-katex-fonts.mjs && npm run build:size-check && npm run build:production-check",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "format": "prettier --write \"{src,docs}/**/*.{ts,tsx,md}\"",
    "prepare": "husky",
    "lint-staged": "lint-staged --config lint-staged.config.mjs",
    "analyze": "analyze --mode static --open false --filename bundle-report",
    "api:lint": "npx @stoplight/spectral lint docs/api/*.yaml",
    "api:lint:strict": "npx @stoplight/spectral lint --fail-severity warn docs/api/*.yaml",
    "api:metadata": "node scripts/api/check-metadata.mjs",
    "api:unused": "node scripts/api/run-unused-check.mjs",
    "api:drift": "node scripts/api/check-endpoint-drift.mjs",
    "api:drift:strict": "node scripts/api/check-endpoint-drift.mjs --strict",
    "api:test": "node scripts/api/run-contract-tests.mjs",
    "api:user-doc:check": "node scripts/api/check-user-api-doc.mjs",
    "api:validate:ci": "npm run api:lint:strict && npm run api:metadata && npm run api:unused && npm run api:test && npm run api:user-doc:check",
    "api:validate": "npm run api:lint:strict && npm run api:metadata && npm run api:unused && npm run api:test && npm run api:user-doc:check && node scripts/api/update-trend.mjs",
    "api:docs": "redocly --version && node scripts/api/build-docs.mjs",
    "api:docs:check": "redocly --version && node scripts/api/build-docs.mjs --check",
    "changelog:sync": "node scripts/changelog/sync-release-notes.mjs",
    "changelog:check": "node scripts/changelog/sync-release-notes.mjs --check",
    "changelog:notify": "tsx scripts/changelog/notify.ts",
    "report:code-metrics": "node scripts/tools/code-metrics.mjs",
    "security:scan-staged": "node scripts/security/scan-secrets.mjs",
    "security:scan": "node scripts/security/scan-secrets.mjs --all",
    "deps:registry:check": "node scripts/dependencies/check-lockfile-registry.mjs",
    "deps:check": "npm run deps:registry:check && knip --include dependencies,unlisted --no-progress",
    "audit:full": "npm audit --registry=https://registry.npmjs.org",
    "audit:full:json": "npm audit --json --registry=https://registry.npmjs.org",
    "audit:full:ci": "node scripts/security/audit-full.mjs",
    "audit:prod": "npm audit --omit=dev --registry=https://registry.npmjs.org",
    "audit:prod:raw:ci": "npm audit --omit=dev --audit-level=high --registry=https://registry.npmjs.org",
    "audit:prod:ci": "node scripts/security/audit-production.mjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest src/__tests__/unit",
    "test:integration": "jest src/__tests__/integration",
    "test:e2e": "node scripts/e2e/run-e2e.mjs",
    "test:e2e:prebuilt": "node scripts/e2e/run-e2e.mjs --prebuilt",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "e2e:semantic-history-image": "node scripts/e2e/semantic-history-image.mjs",
    "e2e:local-preview-smoke": "node scripts/e2e/local-preview-smoke.mjs",
    "scripts:test": "node scripts/run-script-tests.mjs",
    "performance:auth": "node scripts/performance/verify-auth-performance.mjs",
    "release:nginx:candidate": "node scripts/release/nginx-candidate.mjs",
    "release:verify:live": "node scripts/release/verify-live-runtime.mjs",
    "release": "node scripts/release/prepare-release.mjs"
  },
  "dependencies": {
    "@sentry/browser": "^10.59.0",
    "dompurify": "3.4.14",
    "framer-motion": "^12.23.24",
    "jszip": "^3.10.1",
    "katex": "^0.16.25",
    "lucide-react": "^0.546.0",
    "mermaid": "^11.17.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.3",
    "react-syntax-highlighter": "^16.1.0",
    "react-virtuoso": "^4.18.4",
    "rehype-katex": "^7.0.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "web-vitals": "^4.0.2",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@jest/globals": "^30.4.1",
    "@redocly/cli": "^2.34.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.8.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.38.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-react": "^7.35.2",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.4.0",
    "husky": "^9.1.6",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.4.1",
    "jest-environment-jsdom": "^30.4.1",
    "knip": "^6.4.0",
    "lint-staged": "^16.2.5",
    "nodemailer": "^9.0.1",
    "playwright": "^1.58.2",
    "postcss": "^8.5.26",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.18",
    "ts-jest": "^29.4.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^7.3.5",
    "vite-bundle-analyzer": "^1.3.8",
    "vite-tsconfig-paths": "^5.0.0",
    "yaml": "^2.8.1"
  },
  "overrides": {
    "dompurify": "3.4.14",
    "fast-xml-parser": "5.8.0",
    "js-yaml": "4.3.1",
    "lodash-es": "4.18.1",
    "lodash": "4.18.1",
    "esbuild": "0.28.1"
  },
  "browserslist": [
    "Chrome >= 90",
    "Edge >= 90",
    "Firefox >= 90",
    "Safari >= 14"
  ]
}
